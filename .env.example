# =============================================================================
# FC-BRA — variáveis de ambiente
# Configure no Netlify: Site configuration › Environment variables.
# NUNCA faça commit de um arquivo .env com valores reais.
# =============================================================================

# --- Banco de dados (produção) -----------------------------------------------
# Connection string do Supabase (Project Settings › Database › Connection string
# › "Transaction pooler", porta 6543). Sem esta variável o sistema roda em
# MODO DEMONSTRAÇÃO com banco embutido (PGlite) — não use para operar.
DATABASE_URL=
# Aplica migrations pendentes automaticamente ao iniciar (padrão: true).
AUTO_MIGRATE=true
DATABASE_POOL_MAX=5

# --- Segurança ----------------------------------------------------------------
# Segredo longo e aleatório (ex.: `openssl rand -base64 48`). Assina links de
# confirmação de pedido e protege o hash de CPF. Se vazio, um segredo é gerado
# e guardado no banco.
APP_SECRET=
# Código exigido na tela /admin/setup para criar o ADMINISTRADOR PRINCIPAL
# (obrigatório em produção). Depois do primeiro acesso, pode ser removido.
SETUP_TOKEN=
# Duração da sessão do painel, em horas.
SESSION_HOURS=12

# --- Endereço público ---------------------------------------------------------
# URL canônica do site (sitemap, links de convite). No Netlify, URL já existe.
SITE_URL=

# --- E-mail (opcional) — convites e redefinição de senha -----------------------
# Sem estas variáveis, o painel gera links para envio manual.
RESEND_API_KEY=
EMAIL_FROM=

# --- WhatsApp Business Cloud API (opcional) -----------------------------------
# Sem token, todas as mensagens são geradas como link wa.me (padrão).
# O "Phone number ID" de cada marca é configurado no painel (WhatsApp).
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_API_VERSION=v21.0

# --- Modo demonstração ----------------------------------------------------------
# DEMO_SEED=false   → banco embutido começa vazio (sem dados DEMO)
# DEMO_DB_PERSIST=memory → não grava snapshot (testes)
